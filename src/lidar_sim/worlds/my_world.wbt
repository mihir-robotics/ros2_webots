#VRML_SIM R2022b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
}
Viewpoint {
  orientation -0.33185733874619844 -0.09874274160469809 0.9381474178937331 3.686018050088086
  position 1.700313773507203 1.0549607538959629 1.4846240848267684
  follow "my_robot"
}
TexturedBackground{
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 3 3
  wallHeight 0.2
  floorAppearance PBRAppearance {
    baseColor 0.5 0.5 0.5
    roughness 1
    metalness 0
  }
}

# ── MAZE WALLS ───────────────────────────────────────────────────────────────
#
#  S-shaped corridor. Robot starts at (-1.4, -1.4) facing +X (right).
#
#  Corridor 1 — East  : y in [-1.5, -1.1], x from -1.5 to +1.1
#  Corridor 2 — North : x in [+1.1, +1.5], y from -1.1 to +1.5
#  Corridor 3 — West  : y in [+0.8, +1.5], x from -0.8 to +1.5
#
#  No branches, no loops. Each turn is a forced 90° corner.
#  Corridor width: ~0.4 m  |  Wall thickness: 0.1 m  |  Wall height: 0.2 m
#
# ─────────────────────────────────────────────────────────────────────────────

# W1 — North wall of Corridor 1 (horizontal)
#   y = -1.1, runs from x = -1.5 to x = 1.1  (length 2.6)
#   center: (-0.2, -1.1, 0.1)
Solid {
  translation -0.2 -1.1 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 2.6 0.1 0.1 }
    }
  ]
  name "wall_1"
  boundingObject Shape { geometry Box { size 2.6 0.1 0.1 } }
}

# W2 — West wall of Corridor 2 (vertical)
#   x = 1.1, runs from y = -1.1 to y = 0.8  (length 1.9)
#   center: (1.1, -0.15, 0.1)
Solid {
  translation 1.1 -0.15 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 0.1 2.0 0.1 }
    }
  ]
  name "wall_2"
  boundingObject Shape { geometry Box { size 0.1 2.0 0.1 } }
}

# W3 — South wall of Corridor 3 (horizontal)
#   y = 0.8, runs from x = -0.8 to x = 1.1  (length 1.9)
#   center: (0.15, 0.8, 0.1)
Solid {
  translation 0.15 0.8 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 2.0 0.1 0.1 }
    }
  ]
  name "wall_3"
  boundingObject Shape { geometry Box { size 2.0 0.1 0.1 } }
}

Solid {
  translation 0 -0.15 0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.4 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.3 }
    }
  ]
  name "box_1"
  boundingObject Shape { geometry Box { size 0.3 0.3 0.3 } }
}

Robot {
  translation -1.4 -1.4 0
  children [
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.025
      }
      device [
        RotationalMotor {
          name "left wheel motor"
        }
      ]
      endPoint Solid {
        translation 0 0.045 0.025
        children [
          DEF WHEEL Transform {
            rotation 1 0 0 1.5707996938995747
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 1 0 0
                  roughness 1
                  metalness 0
                }
                geometry Cylinder {
                  height 0.01
                  radius 0.025
                }
              }
            ]
          }
        ]
        name "left wheel"
        boundingObject USE WHEEL
        physics Physics {
        }
      }
    }

    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.025
      }
      device [
        RotationalMotor {
          name "right wheel motor"
        }
      ]
      endPoint Solid {
        translation 0 -0.045 0.025
        children [
          USE WHEEL
        ]
        name "right wheel"
        boundingObject USE WHEEL
        physics Physics {
        }
      }
    }

    # Main robot body (slightly shorter)
    Transform {
      translation 0 0 0.035
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 0 1
            roughness 1
            metalness 0
          }
          geometry DEF BODY Cylinder {
            height 0.06
            radius 0.045
          }
        }
      ]
    }

    # Optional lidar mast
    Transform {
      translation 0 0 0.075
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            radius 0.005
            height 0.02
          }
        }
      ]
    }

    Camera {
      translation 0.052 0 0.07
      rotation 0 1 0 0
      width 320
      height 240
      name "camera"
    }

    Lidar {
      translation 0 0 0.09
      rotation 0 0 1 0
      name "lidar"
      numberOfLayers 1
      maxRange 3
      horizontalResolution 360
      fieldOfView 6.283185307
      verticalFieldOfView 1
      type "fixed"
    }
  ]

  boundingObject Transform {
    translation 0 0 0.035
    children [
      USE BODY
    ]
  }

  physics Physics {
  }

  controller "<extern>"
  name "my_robot"
}
