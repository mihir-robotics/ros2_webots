# ── MAZE WALLS ───────────────────────────────────────────────────────────────
#
#  S-shaped corridor. Robot starts at (-1.4, -1.4) facing +X (right).
#
#  Corridor 1 — East  : y in [-1.5, -1.1], x from -1.5 to +1.1
#  Corridor 2 — North : x in [+1.1, +1.5], y from -1.1 to +1.5
#  Corridor 3 — West  : y in [+0.8, +1.5], x from -0.8 to +1.5
#
#  No branches, no loops. Each turn is a forced 90° corner.
#  Corridor width: ~0.4 m  |  Wall thickness: 0.1 m  |  Wall height: 0.2 m
#
# ─────────────────────────────────────────────────────────────────────────────

# W1 — North wall of Corridor 1 (horizontal)
#   y = -1.1, runs from x = -1.5 to x = 1.1  (length 2.6)
#   center: (-0.2, -1.1, 0.1)
Solid {
  translation -0.2 -1.1 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 2.6 0.1 0.2 }
    }
  ]
  name "wall_1"
  boundingObject Shape { geometry Box { size 2.6 0.1 0.2 } }
  physics Physics {}
}

# W2 — West wall of Corridor 2 (vertical)
#   x = 1.1, runs from y = -1.1 to y = 0.8  (length 1.9)
#   center: (1.1, -0.15, 0.1)
Solid {
  translation 1.1 -0.15 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 0.1 1.9 0.2 }
    }
  ]
  name "wall_2"
  boundingObject Shape { geometry Box { size 0.1 1.9 0.2 } }
  physics Physics {}
}

# W3 — South wall of Corridor 3 (horizontal)
#   y = 0.8, runs from x = -0.8 to x = 1.1  (length 1.9)
#   center: (0.15, 0.8, 0.1)
Solid {
  translation 0.15 0.8 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 1.9 0.1 0.2 }
    }
  ]
  name "wall_3"
  boundingObject Shape { geometry Box { size 1.9 0.1 0.2 } }
  physics Physics {}
}

# W4 — West end cap of Corridor 3 (vertical)
#   x = -0.8, runs from y = 0.8 to y = 1.5  (length 0.7)
#   center: (-0.8, 1.15, 0.1)
Solid {
  translation -0.8 1.15 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 0.1 0.7 0.2 }
    }
  ]
  name "wall_4"
  boundingObject Shape { geometry Box { size 0.1 0.7 0.2 } }
  physics Physics {}
}

Robot {
  translation -1.4 -1.4 0
  children [
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.025
      }
      device [
        RotationalMotor {
          name "left wheel motor"
        }
      ]
