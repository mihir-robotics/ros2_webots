# Aruco_1
Solid {
  translation 1.49 -1.39 0.10
  rotation 0 1 0 -1.5708
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url [ "aruco_0.png" ]
        }
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 0.15 0.15
      }
    }
  ]
  name "aruco_0"
}

