WorldInfo {
}
Viewpoint {
  orientation -0.33185733874619844 -0.09874274160469809 0.9381474178937331 3.686018050088086
  position 1.700313773507203 1.0549607538959629 1.4846240848267684
  follow "bot"
}
TexturedBackground{
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 3 3
  wallHeight 0.2
  floorAppearance PBRAppearance {
    baseColor 0.5 0.5 0.5
    roughness 1
    metalness 0
  }
}

# W1 — North wall of Corridor 1 (horizontal)
#   y = -1.1, runs from x = -1.5 to x = 1.1  (length 2.6)
#   center: (-0.2, -1.1, 0.1)
Solid {
  translation -0.15 -1.25 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 2.6 0.02 0.1 }
    }
  ]
  name "wall_1"
  boundingObject Shape { geometry Box { size 2.6 0.02 0.1 } }
}

# W2 — West wall of Corridor 2 (vertical)
#   x = 1.1, runs from y = -1.1 to y = 0.8  (length 1.9)
#   center: (1.1, -0.15, 0.1)
Solid {
  translation 1.1 -0.25 0.1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 0.02 2.0 0.1 }
    }
  ]
  name "wall_2"
  boundingObject Shape { geometry Box { size 0.02 2.0 0.1 } }
}

# W3 — South wall of Corridor 3 (horizontal)
#   y = 0.8, runs from x = -0.8 to x = 1.1  (length 1.9)
#   center: (0.15, 0.8, 0.1)
Solid {
  translation 0.0502 0.8055 0.1
  rotation 0 0 1 -0.055
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.8 roughness 1 metalness 0 }
      geometry Box { size 2.2 0.02 0.1 }
    }
  ]
  name "wall_3"
  boundingObject Shape { geometry Box { size 2.2 0.02 0.1 } }
}

